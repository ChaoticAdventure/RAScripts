// Normal Stuff
function demoProtection() => demo() != 0x81
function inDungeon(dungeon) => byte(0xd5ee) == dungeon
function progression(floor) => inDungeon(Dungeons["Main"]) && floor() == floor && prev(inDungeonFlag()) == 1 && inDungeonFlag() == 0
function trials(floor) => inDungeon(Dungeons["Trials"]) && prev(floor()) == floor && floor() == floor + 1
function wonGame() => inDungeon(Dungeons["Main"]) && prev(bit0(0xD2AB)) < bit0(0xD2AB)
function wonGameWithoutStorage() => inDungeon(Dungeons["Main"]) && prev(bit0(0xd2b2)) < bit0(0xd2b2)
function wonFei() => prev(bit4(0xD2AB)) < bit4(0xD2AB)
function identifiedItem() { // To see if the player has ID'd any item
    StaffBase = 0x9088
    StaffBase2 = 0x9090
    BracerBase = 0x909f
    PotBase = 0x90c0
    return any_of(range(0, 6), i => prev(byte(StaffBase + i)) == 0 && byte(StaffBase + i) == 1) ||
           any_of(range(0,2), i => prev(byte(StaffBase2 + i)) == 0 && byte(StaffBase2 + i) == 1) ||
           any_of(range(0, 14), i => prev(byte(BracerBase + i)) == 0 && byte(BracerBase + i) == 1) ||
           any_of(range(0, 13), i => prev(byte(PotBase + i)) == 0 && byte(PotBase + i) == 1)
}
function feiProblems(num) => prev(feisProblemsSolved()) == num - 1 && feisProblemsSolved() == num

// Item Array Parsing
function weaponEquipped() => byte(0x008970)
function shieldEquipped() => byte(0x008971)
function bracerEquipped() => byte(0x008972)
function projectileEquipped() => byte(0x008973)

// Bases for each of the arrays. The inventory array is 20 Bytes, all the others are 127 Bytes. 
InventoryBase = 0x894f
ItemBase = 0x8B8C
StateBase = 0x8C8C
SubstateBase = 0x8D0C
CurseBase = 0x008c0c
DiscoveredBase = 0x008d8c
PotItemBase = 0x008e0c
ShopItemBase = 0x008e8c
ExtraQualities1Base = 0x008f0c
ExtraQualities2Base = 0x008f8c

MaxOffset = 0x7e

// Read the index from the inventory slot, add it to the larger item array base, then read the final ID
function addedToInventory(ID) {
    return any_of(range(0, 19), i => 
    prev(byte(InventoryBase + i)) == 0xff &&
    byte(InventoryBase + i) <= MaxOffset &&
    byte(ItemBase + byte(InventoryBase + i)) == ID
    )
}

// See if the amount of items in your inventory has decreased
function removedFromInventory() {
    return any_of(range(0,19), i =>
        prev(byte(InventoryBase + i)) <= MaxOffset &&
        byte(InventoryBase + i) == Items["Nothing"]
    )
}

// For seeing if a weapon has been enhanced. Skips the inventory check because items leave yourinventory when they get enhanced.
function strengthened(str = 0) {
    if (str == 0) {
        return any_of(range(0, 126), i => 
        byte(ItemBase + i) <= 0x0f &&
        prev(byte(ItemBase + i)) == byte(ItemBase + i) &&
        prev(byte(StateBase + i)) < byte(StateBase + i) &&
        byte(StateBase + i) <= 99
        )
    }
    else {
        return any_of(range(0, 126), i => 
        byte(ItemBase + i) <= 0x0f &&
        prev(byte(ItemBase + i)) == byte(ItemBase + i) &&
        prev(byte(StateBase + i)) < str &&
        byte(StateBase + i) >= str &&
        byte(StateBase + i) <= 99
        )
    }
}

function forged(ID1,ID2) { // For forging achievements
    return any_of(range(0, 126), i => 
    prev(byte(ItemBase + i)) == ID1 &&  
    byte(ItemBase + i) == ID2
    )
}

function addedToFloor(ID) { // For pickaxe achievement, sees if an item has been added to the floor.
    return any_of(range(0,126), i =>
    prev(byte(ItemBase + i)) == 0xff &&
    byte(ItemBase + i) == ID
    )
}

function inventoryState(deltaState,state) {
    return any_of(range(0, 19), i => 
           prev(byte(ItemBase + byte(StateBase + i)) == deltaState) &&
           byte(ItemBase + byte(StateBase + i)) == state
           ) 
}

// Theft function
// Sees if an item disappeared from the shop, that it wasn't bought,and that you didn't get caught.
function shopTheft() {
        return byte(0x008995) == 0 &&
        prev(byte(0x00d5fd)) == byte(0x00d5fd) &&
        prev(floor()) == floor() && // Protection against the shop disappearing
        any_of(range(0, 126), i =>
        prev(byte(ItemBase + i)) == byte(ItemBase + i) &&
        prev(byte(ShopItemBase + i)) == 1 &&
        byte(ShopItemBase + i) == 0
        )
}

// Extra Quality checker for Synthesis achievements
function extraQuality(bita, bitb = byte, bitc = byte, bitd = byte) {
    if (bitb == byte) { // Equals 8 because Bit7 indicates that the weapon is forged, so +1.
        return any_of(range(0,126), i =>
            byte(ItemBase + i) <= Items["RasenFumaShield"] &&
            prev(bitcount(ExtraQualities1Base + i)) + prev(bitcount(ExtraQualities2Base + i)) <= 7 &&
            bitcount(ExtraQualities1Base + i) + bitcount(ExtraQualities2Base + i) >= 8
        )
    }
    else if (bitc == byte) {
        return any_of(range(0,126), i =>
            byte(ItemBase + i) <= Items["RasenFumaShield"] &&
            prev(bita(ExtraQualities1Base + i)) + prev(bitb(ExtraQualities1Base + i)) == 1 &&
            bita(ExtraQualities1Base + i) + bitb(ExtraQualities1Base + i) == 2
        )
    }
    else {
        return any_of(range(0,126), i =>
            byte(ItemBase + i) <= Items["RasenFumaShield"] &&
            prev(bita(ExtraQualities1Base + i)) + prev(bitb(ExtraQualities1Base + i)) +
            prev(bitc(ExtraQualities1Base + i)) + prev(bitd(ExtraQualities1Base + i)) == 1 &&
            bita(ExtraQualities1Base + i) + bitb(ExtraQualities1Base + i) +
            bitc(ExtraQualities1Base + i) + bitd(ExtraQualities1Base + i) == 2
        )
    }
}

