// Leaderboard Values
MainScore = 0x02600b
MainFloor = MainScore + 7
KitchenGodScore = 0x0267dc
KitchenGodFloor = KitchenGodScore + 7
ScrollCaveScore = 0x026fad
ScrollCaveFloor = ScrollCaveScore + 7
FinalProblemScore = 0x02777e
FinalProblemFloor = FinalProblemScore + 7

function firstPlaceFloor(num) {
    return prev(byte(num)) < byte(num)    
}
function firstPlaceScore(num) {
    return prev(dword(num)) < dword(num)    
}

leaderboard("Main Dungeon High Floor", "Get to the highest floor in the Main dungeon and get first place in the Explorer's Ranking",
    demoProtection() && firstPlaceFloor(MainFloor), // Start
    always_false(), // Cancel - Never
    always_true(), // Submit - Always
    measured(byte(MainFloor)), // Measured
    format="VALUE",lower_is_better=false, id=0
    )
    
leaderboard("Main Dungeon High Score", "Attain the highest score in the Main dungeon and get first place in the Explorer's Ranking",
    demoProtection() && firstPlaceScore(MainScore), // Start
    always_false(), // Cancel - Never
    always_true(), // Submit - Always
    measured(dword(MainScore)), // Measured
    format="VALUE",lower_is_better=false, id=0
    )

